{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smile AI Image",
  "version": "1.0.9",
  "identifier": "com.smile-ai.image",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Smile AI Image",
        "width": 840,
        "height": 670,
        "minWidth": 680,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "category": "Graphics and Design",
    "shortDescription": "Smile AI Image settings for Codex",
    "longDescription": "Configure the Smile AI relay, image model, resolution, aspect ratio, and quality used by Codex.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
